local function C_59()
local script = G2L["59"];
	local button = script.Parent -- Reference to the ConfirmButton
	local players = game:GetService("Players") -- Service to interact with players
	stopvalue = false
	
	pcall(function()
		game.Workspace.FallenPartsDestroyHeight = 0/0
	end)
	
	-- Function to check if the player exists
	local function playerExists(nickname)
		for _, player in ipairs(game.Workspace:GetChildren()) do
			if player.Name:lower() == nickname:lower() or string.find(player.Name:lower(), nickname:lower()) then
				return player
			end
		end
		return nil
	end
	
	-- Teleport the local player to the target player
	local function teleportToPlayer(targetPlayer)
		local localPlayer = players.LocalPlayer
		if localPlayer and localPlayer.Character and targetPlayer.PrimaryPart then
			local pingFrame = math.random(-7.5, 15)
			local targetVelocity = targetPlayer.PrimaryPart.Velocity
			local predictedDisplacement = pingFrame / 10 * targetVelocity -- Predicting player position
			local targetPosition = targetPlayer.PrimaryPart:GetPivot().Position + predictedDisplacement
			localPlayer.Character:PivotTo(CFrame.new(targetPosition))
			if stopvalue == false then
				-- nothing
			else
				localPlayer.Character.HumanoidRootPart.Velocity = Vector3.new(0, 16000, 0)
			end
		end
	end
	
	
	local function resetLocalPlayer()
		pcall(function()
			game.Players.LocalPlayer.Character.Head:Destroy()
			game.Players.LocalPlayer.Character.Humanoid.Health = 0
		end)
	end
	
	-- Button click event
	button.MouseButton1Click:Connect(function()
		local inputGui = button.Parent
		local textBox = inputGui:FindFirstChildWhichIsA("TextBox")
		if textBox then
			local targetPlayer = playerExists(textBox.Text)
			if targetPlayer then
				local playerPos = players.LocalPlayer.Character.HumanoidRootPart.Position
				if stopvalue == true then
					stopvalue = false
					button.Text = "Confirm"
					task.spawn(function()
						for i = 1, 50 do
							task.wait()
							print("debug")
							players.LocalPlayer.Character.HumanoidRootPart.Velocity = Vector3.new(0, 0, 0)
							players.LocalPlayer.Character.HumanoidRootPart:PivotTo(CFrame.new(0, 15, 100))
						end
					end)
				else
					stopvalue = true
					button.Text = "Stop"
				end
				wait(0.1)
				repeat 
					task.wait()
					-- get output in isolated pcall
					local success, output = pcall(function()
						local targetPlayer = playerExists(textBox.Text)
						teleportToPlayer(targetPlayer)
					end)
					if not success then
						print("Teleport failed:", output)
					end
				until stopvalue == false
			end
		end
	end)
end;
