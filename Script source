local runService = game:GetService("RunService")
runService.Heartbeat:Connect(function()
    if isScriptEnabled then
        local remoteEvent = replicatedStorage:FindFirstChild("Events")
            and replicatedStorage.Events:FindFirstChild("Remote")
            and replicatedStorage.Events.Remote:FindFirstChild("Client")
            and replicatedStorage.Events.Remote.Client:FindFirstChild("changeRopeLength")

        if remoteEvent then
            local args = {
            	[1] = -1
        	}
            remoteEvent:FireServer(unpack(args))
        else
            warn("Remote event changeRopeLength not found!")
        end
    end
end)

