-- StarterGui.NLv4.MainFrame.RightSide.Grappler.GKillbutton.LocalScript
local function C_1f()
local script = G2L["1f"];
	task.spawn(function()
		-- Script for toggling on and off when the button is clicked
	
		local button = script.Parent
		togglerGK = false
	
		button.MouseButton1Click:Connect(function()
			togglerGK = not togglerGK
			if togglerGK then
				-- Code to execute when toggled on
				print("Toggled on")
				button.TextStrokeColor3 = Color3.new(0, 1, 0)
			else
				-- Code to execute when toggled off
				print("Toggled off")
				button.TextStrokeColor3 = Color3.new(0.666667, 0, 0)
			end
		end)
	
	end)
	
	pcall(function()
		local mainUI = game.Players.LocalPlayer.PlayerGui.mainUI
		local grappling = mainUI.grappling
		local nameLabel = grappling.name
	
		-- Function to extract player nickname from the string (if needed)
		local function extractPlayerNickname(str)
			return str
		end
	
		-- Function to check if a player is in the local player's friend list
		local function isPlayerFriend(player)
			return game.Players.LocalPlayer:IsFriendsWith(player.UserId)
		end
	
		-- Function to repeatedly set player's head position
		local function killPlayer(head)
			repeat
				head.Position = Vector3.new(0, -15.75, 0)
				task.wait(0.01)
			until head.Parent:FindFirstChild("Humanoid").Health == 0 or togglerGK == false
			
			if head.Parent:FindFirstChild("Humanoid").Health <= 1 then
				game.StarterGui:SetCore("SendNotification", {
					Title = "Grapple Killed a Player",
					Text = "Killed ".. head.Parent.Name,
					Duration = 5,
				})
			end
		end
	
		-- Continuously check visibility of the text label
		game:GetService("RunService").Heartbeat:Connect(function()
			if grappling.Visible and togglerGK then
				local playerName = extractPlayerNickname(nameLabel.Text)
				local player = game.Players:FindFirstChild(playerName)
	
				if player then
					if isPlayerFriend(player) then
						print("Player", playerName, "is a friend, ignoring...")
					else
						print("Step 1: Player found in game.Players")
						local character = player.Character
						if character then
							print("Step 2: Character found for player", playerName)
							local head = character:FindFirstChild("Head")
							if head then
								print("Step 3: Head found for player", playerName)
								task.spawn(function()
									killPlayer(head)
								end)
							else
								warn("Warning: Head not found for player", playerName)
							end
						else
							warn("Warning: Character not found for player", playerName)
